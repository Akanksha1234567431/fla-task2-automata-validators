digraph G {
  rankdir=LR;
  bgcolor=white;
  node [shape=circle, fontname="Helvetica", fontsize=12];
  edge [fontname="Helvetica", fontsize=11];
  labelloc=b; labeljust=l; fontname="Helvetica"; fontsize=11; label="Fig. 6b  Rule automaton: contains at least one U (same shape for L, D, S)\lAlphabet classes:\l  U = uppercase A-Z\l  L = lowercase a-z\l  D = digit 0-9\l  S = ASCII punctuation\l  X = any other character\l";
  __start [shape=point, width=0.15, label=""];
  n0 [label="no", shape=circle];
  n1 [label="yes", shape=doublecircle];
  __start -> n0;
  n0 -> n0 [label="D, L, S, X"];
  n0 -> n1 [label="U"];
  n1 -> n1 [label="D, L, S, U, X"];
}
