digraph G {
  rankdir=LR;
  bgcolor=white;
  node [shape=circle, fontname="Helvetica", fontsize=12];
  edge [fontname="Helvetica", fontsize=11];
  labelloc=b; labeljust=l; fontname="Helvetica"; fontsize=11; label="Fig. 5  Scaled-down password DFA: length 3-4, >=1 letter, >=1 digit\lAlphabet classes:\l  L = letter\l  D = digit\lMoves into the dead (trap) state are omitted.\l";
  __start [shape=point, width=0.15, label=""];
  n0 [label="q0", shape=circle];
  n1 [label="q1", shape=circle];
  n2 [label="q2", shape=circle];
  n3 [label="q3", shape=circle];
  n4 [label="q4", shape=circle];
  n5 [label="q5", shape=circle];
  n6 [label="q6", shape=circle];
  n7 [label="q7", shape=doublecircle];
  n8 [label="q8", shape=circle];
  n9 [label="q9", shape=doublecircle];
  __start -> n0;
  n0 -> n1 [label="D"];
  n0 -> n2 [label="L"];
  n1 -> n3 [label="D"];
  n1 -> n4 [label="L"];
  n2 -> n4 [label="D"];
  n2 -> n5 [label="L"];
  n3 -> n6 [label="D"];
  n3 -> n7 [label="L"];
  n4 -> n7 [label="D, L"];
  n5 -> n7 [label="D"];
  n5 -> n8 [label="L"];
  n6 -> n9 [label="L"];
  n7 -> n9 [label="D, L"];
  n8 -> n9 [label="D"];
}
