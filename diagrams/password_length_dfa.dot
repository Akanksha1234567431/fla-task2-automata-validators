digraph G {
  rankdir=LR;
  bgcolor=white;
  node [shape=circle, fontname="Helvetica", fontsize=12];
  edge [fontname="Helvetica", fontsize=11];
  labelloc=b; labeljust=l; fontname="Helvetica"; fontsize=11; label="Fig. 6a  Rule automaton: 8 <= length <= 16 (any class)\lAlphabet classes:\l  any symbol = U, L, D, S or X\lMoves into the dead (trap) state are omitted.\l";
  __start [shape=point, width=0.15, label=""];
  n0 [label="n0", shape=circle];
  n1 [label="n1", shape=circle];
  n2 [label="n2", shape=circle];
  n3 [label="n3", shape=circle];
  n4 [label="n4", shape=circle];
  n5 [label="n5", shape=circle];
  n6 [label="n6", shape=circle];
  n7 [label="n7", shape=circle];
  n8 [label="n8", shape=doublecircle];
  n9 [label="n9", shape=doublecircle];
  n10 [label="n10", shape=doublecircle];
  n11 [label="n11", shape=doublecircle];
  n12 [label="n12", shape=doublecircle];
  n13 [label="n13", shape=doublecircle];
  n14 [label="n14", shape=doublecircle];
  n15 [label="n15", shape=doublecircle];
  n16 [label="n16", shape=doublecircle];
  __start -> n0;
  n0 -> n1 [label="D, L, S, U, X"];
  n1 -> n2 [label="D, L, S, U, X"];
  n2 -> n3 [label="D, L, S, U, X"];
  n3 -> n4 [label="D, L, S, U, X"];
  n4 -> n5 [label="D, L, S, U, X"];
  n5 -> n6 [label="D, L, S, U, X"];
  n6 -> n7 [label="D, L, S, U, X"];
  n7 -> n8 [label="D, L, S, U, X"];
  n8 -> n9 [label="D, L, S, U, X"];
  n9 -> n10 [label="D, L, S, U, X"];
  n10 -> n11 [label="D, L, S, U, X"];
  n11 -> n12 [label="D, L, S, U, X"];
  n12 -> n13 [label="D, L, S, U, X"];
  n13 -> n14 [label="D, L, S, U, X"];
  n14 -> n15 [label="D, L, S, U, X"];
  n15 -> n16 [label="D, L, S, U, X"];
}
